{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Janie & Cooper site: film page + the Godot web build (Workers static assets).
  // Build: Godot "Web" export -> export/web/game, then tools/web_postprocess.py; site/index.html -> export/web/.
  "name": "janie-cooper",
  "compatibility_date": "2026-09-25",
  "observability": { "enabled": true },
  "assets": { "directory": "export/web" },
  // Protected by Cloudflare Access (Zero Trust app "janie-cooper": account members + Family emails).
  "workers_dev": true,
  "preview_urls": false
}

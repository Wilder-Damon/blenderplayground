{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Janie & Cooper site: film page + the Godot web build (Workers static assets).
  // Build: Godot "Web" export -> export/web/game, then tools/web_postprocess.py; site/index.html -> export/web/.
  "name": "janie-cooper",
  "compatibility_date": "2026-09-25",
  "observability": { "enabled": true },
  "assets": { "directory": "export/web" },
  // Public (Access login removed 2026-09-26 so it can be shared); re-add via the Worker's Access tab if needed.
  "workers_dev": true,
  "preview_urls": false
}
